  "captions": [
    {
      "from": 330,
      "text": {
        "en": "New Rome on the Bosporus: Constantine's city rises inside his new land wall.",
        "zh": "博斯普鲁斯海峡畔的新罗马：君士坦丁的城市在新筑的陆墙内拔地而起。"
      }
    },
    {
      "from": 413,
      "text": {
        "en": "The Theodosian Walls enclose a city grown far beyond Constantine's line.",
        "zh": "狄奥多西城墙环抱着早已越出君士坦丁城界的都城。"
      }
    },
    {
      "from": 537,
      "text": {
        "en": "Justinian's Hagia Sophia crowns the first hill; the capital nears half a million souls.",
        "zh": "查士丁尼的圣索菲亚大教堂高踞第一山丘；都城人口近五十万。"
      }
    },
    {
      "from": 542,
      "text": {
        "en": "Plague empties whole quarters; gardens and fields creep back inside the walls.",
        "zh": "大瘟疫令整片街区人去楼空，园圃与田地重新蔓入城墙之内。"
      }
    },
    {
      "from": 717,
      "text": {
        "en": "A shrunken city of perhaps fifty thousand holds its walls against the great Arab siege.",
        "zh": "人口或仅五万的萎缩之城，凭城墙顶住了阿拉伯大军的围攻。"
      }
    },
    {
      "from": 900,
      "text": {
        "en": "Recovery under the Macedonian emperors: the Queen of Cities fills again.",
        "zh": "马其顿王朝治下的复兴：众城之女王重新繁盛起来。"
      }
    },
    {
      "from": 1081,
      "text": {
        "en": "The Komnenoi rule from Blachernae by the land walls; Italian merchants crowd the Golden Horn.",
        "zh": "科穆宁王朝移驾陆墙边的布拉赫奈宫；意大利商人云集金角湾。"
      }
    },
    {
      "from": 1204,
      "text": { "en": "Sacked by the Fourth Crusade: fires have gutted the city's heart.", "zh": "第四次十字军洗劫：大火焚毁了城市的心脏。" }
    },
    {
      "from": 1261,
      "text": {
        "en": "Rome returns to its capital — a city of villages within walls too long to man.",
        "zh": "罗马重返故都——城墙之内是村落零落的城市，城墙长得已难以驻守。"
      }
    },
    {
      "from": 1348,
      "text": {
        "en": "Genoese Galata raises its tower across the Horn and outtrades the imperial city.",
        "zh": "热那亚人的加拉塔在金角湾对岸竖起高塔，贸易盖过了帝都。"
      }
    },
    {
      "from": 1453,
      "text": {
        "en": "The last spring: some fifty thousand Romans behind the thousand-year walls.",
        "zh": "最后的春天：约五万罗马人守在千年城墙之后。"
      }
    }
  ],
